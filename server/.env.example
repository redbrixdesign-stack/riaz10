# AdvisorOS AI proxy — server/.env
# Copy this file to .env and fill in the values. NEVER commit .env.

# Required: your Anthropic API key (server-side only, never ships to the app).
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional in dev, REQUIRED in production: a shared secret the app sends as
# the X-AI-Key header (CONFIG.ai.secret). Anyone without it gets 403.
AI_SECRET=

# Optional in dev, REQUIRED in production: the exact origin that may call
# the proxy, e.g. https://your-advisor-app.pages.dev — every other origin
# gets 403. With NODE_ENV=production the proxy refuses ALL requests until
# this and AI_SECRET are both set.
ALLOWED_ORIGIN=

# Optional: rate limiting per client address (sliding window).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Optional: upstream (Anthropic) call budget before the proxy aborts.
ANTHROPIC_TIMEOUT_MS=60000

# Optional: port the server listens on (default 8787).
PORT=8787

# Set to production on the deployment; dev keeps the security checks
# lenient (warnings only) so local testing stays easy.
NODE_ENV=development